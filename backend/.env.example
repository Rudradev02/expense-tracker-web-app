# Production Database URL (e.g. Neon, Supabase, Render PostgreSQL)
# Example: postgresql://user:password@ep-cool-project.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///database.db

# Flask Secret Key for JWT encryption and session cookies
SECRET_KEY=generate_a_secure_random_key_here

# Frontend URL for CORS (e.g. your Vercel deployment URL)
# Example: https://expense-tracker.vercel.app
FRONTEND_URL=https://expense-tracker.vercel.app

# Port (set automatically by Render / Railway / Heroku)
PORT=5000
