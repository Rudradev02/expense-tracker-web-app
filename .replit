modules = ["nodejs-20", "web", "python-3.12"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "rustc"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh -c '(cd backend && ../.pythonlibs/bin/gunicorn --bind 127.0.0.1:5001 app:app) & (cd frontend && ../node_modules/.bin/vite --host 0.0.0.0 --port 5000)'"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5123
externalPort = 3001
exposeLocalhost = true
